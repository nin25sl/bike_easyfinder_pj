# Local-only defaults. Change the password before sharing a database host.
POSTGRES_DB=bike_easyfinder
POSTGRES_USER=bike
POSTGRES_PASSWORD=bike_local_only
POSTGRES_PORT=5432

# Do not commit a real key. Set this in the shell or in an ignored .env file.
OPENAI_API_KEY=

# Public API. approximate is deterministic and local/test only.
APP_ENV=local
API_PORT=8000
ROUTE_PROVIDER=approximate
APPLE_MAPS_ACCESS_TOKEN=
RECOMMENDATION_RULE_VERSION=mvp-1.1
DATA_VERSION=canonical-local
